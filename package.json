{
  "name": "rs-react-nextjs-ssr-ssg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify:harness": "node scripts/verify-harness.mjs",
    "instructions:sync": "node scripts/sync-instructions.mjs",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@12.4.1",
  "aiCoaching": {
    "task": "Task 8",
    "note": "This repo uses an AI coaching harness. See CLAUDE.md. Do not disarm it; integrity is checked by scripts/verify-harness.mjs.",
    "instructionFiles": [
      "CLAUDE.md",
      "AGENTS.md",
      "GEMINI.md",
      ".github/copilot-instructions.md",
      ".cursor/rules/coaching.mdc"
    ]
  }
}
