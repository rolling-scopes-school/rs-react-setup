{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "deny": ["mcp__playwright__browser_run_code_unsafe"]
  },
  "outputStyle": "Coach",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/coach-reminder.mjs\""
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "hooks-review": "on",
    "composition-review": "on",
    "a11y-review": "on"
  }
}
